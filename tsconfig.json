{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types",
      "../../openfox/node_modules/@types"
    ],
    "types": ["node"],
    "paths": {
      "openfox/plugin": ["../../openfox/src/plugin/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js"],
  "exclude": []
}
